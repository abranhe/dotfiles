#!/bin/bash

# Homebrew's prefix, /opt/homebrew on Apple Silicon and /usr/local on Intel.
BREW_PREFIX="${HOMEBREW_PREFIX:-/usr/local}"

# Go
export GOPATH="${HOME}/go"
export PATH="$PATH:${GOPATH}/bin"

# PHP
PHP_VERSION=8.2 # 7.4, 8.1, 8.2
export PATH="$BREW_PREFIX/opt/php@$PHP_VERSION/bin:$PATH"
export PATH="$BREW_PREFIX/opt/php@$PHP_VERSION/sbin:$PATH"

# Rust
export PATH="${HOME}/.cargo/bin:$PATH"

# Ruby
export PATH="$BREW_PREFIX/opt/ruby/bin:$PATH"

# MySQL
export PATH="$BREW_PREFIX/opt/mysql@8.0/bin:$PATH"
export PATH="$BREW_PREFIX/opt/mysql-client/bin:$PATH"

# The bin/ folder of every layer is added by .zshrc.

unset BREW_PREFIX
